# sirene.ucf — deux broches, rien d'autre.
# La broche de sortie se change ici, et NULLE PART AILLEURS.
CONFIG VCCAUX = "3.3";
NET "clk_50" TNM_NET = TNM_clk50;
TIMESPEC TS_clk50 = PERIOD "TNM_clk50" 20 ns HIGH 50%;
NET "clk_50" LOC = "P51" | IOSTANDARD = LVCMOS33;
NET "son"    LOC = "P44" | IOSTANDARD = LVCMOS33 | DRIVE = 12 | SLEW = SLOW;
